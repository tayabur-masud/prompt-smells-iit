# Any OpenAI-compatible Chat Completions provider works; change these three to switch.
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

LLM_TEMPERATURE=0
LLM_MAX_TOKENS=1000
LLM_TIMEOUT=60
# Set to false if the provider rejects response_format={"type": "json_object"}
LLM_JSON_MODE=true

# Optional, only if your provider needs them
LLM_ORGANIZATION=
LLM_PROJECT=

# Examples:
# OpenRouter:  LLM_BASE_URL=https://openrouter.ai/api/v1   LLM_MODEL=openai/gpt-4o-mini
# Groq:        LLM_BASE_URL=https://api.groq.com/openai/v1 LLM_MODEL=llama-3.1-8b-instant
# Ollama:      LLM_BASE_URL=http://localhost:11434/v1     LLM_MODEL=llama3.1  LLM_API_KEY=ollama
# LM Studio:   LLM_BASE_URL=http://localhost:1234/v1      LLM_MODEL=<loaded-model>  LLM_API_KEY=lm-studio
